# Server only. Prefer a restricted key (rk_). Never commit real values.
# Live keys stay unused until STRIPE_ALLOW_LIVE=1. This run does not set that.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=

# New tables stripe_bestellungen and stripe_ereignisse. Service role, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated. Checkout redirects only to these origins.
SITE_ORIGINS=https://www.shiftmyhorizon.com

# Empty until a Stripe Price exists for that offer. Never the Abschalt-Bericht price.
STRIPE_PRICE_INTEGRATED_MAN=
STRIPE_PRICE_LOVING_WOMAN=
STRIPE_PRICE_CAREER_POWER=
STRIPE_PRICE_ELITE_CLOSER=
STRIPE_PRICE_LIGHTNESS=
STRIPE_PRICE_INTEGRATED_SOUL=
STRIPE_PRICE_PARENT_IN_PEACE=
STRIPE_PRICE_CONNECTED_COUPLES=
