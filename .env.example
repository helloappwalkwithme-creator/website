# Server only. Prefer a restricted key (rk_). Never commit real values.
# Live keys stay unused until STRIPE_ALLOW_LIVE=1. This run does not set that.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=

# New tables stripe_bestellungen and stripe_ereignisse. Service role, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated. Checkout redirects only to these origins.
SITE_ORIGINS=https://www.shiftmyhorizon.com

# Public live Price IDs. Not secrets. The server uses these when the variable is empty.
# Checkout stays closed until the restricted key, the webhook secret, and a live
# read of the Price all succeed. Each Price must be EUR 1900, month, interval_count 1, no trial.
STRIPE_PRICE_PORN_RECOVERY=price_1UZw2NDtpOTBAOYv8RVT67E9
STRIPE_PRICE_GETTINGGIRLS=price_1UZw2TDtpOTBAOYvtVfXUWnt
