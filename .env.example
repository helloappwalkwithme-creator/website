# Server only. Prefer a restricted key (rk_). Never commit real values.
# Live keys stay unused until STRIPE_ALLOW_LIVE=1. This run does not set that.
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=

# New tables stripe_bestellungen and stripe_ereignisse. Service role, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated. Checkout redirects only to these origins.
SITE_ORIGINS=https://www.shiftmyhorizon.com

# One Price per Supabase flow. Must be EUR 1900, month, interval_count 1, no trial.
STRIPE_PRICE_PORN_RECOVERY=
STRIPE_PRICE_GETTINGGIRLS=
STRIPE_PRICE_MENS_RELATIONSHIP=
STRIPE_PRICE_CAREER=
STRIPE_PRICE_SALES=
STRIPE_PRICE_MAIN_CHARACTER=
STRIPE_PRICE_HIGH_VALUE_DATING=
STRIPE_PRICE_HEARTBREAK=
STRIPE_PRICE_LEICHTIGKEIT=
STRIPE_PRICE_SECULAR=
STRIPE_PRICE_PARENTING_LOOP=
STRIPE_PRICE_PARENTAL_BURNOUT=
