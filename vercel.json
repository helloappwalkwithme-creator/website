{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "shiftmyhorizon.com" }],
      "destination": "https://www.shiftmyhorizon.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "shiftmyhorizon.com" }],
      "destination": "https://www.shiftmyhorizon.com/:path*",
      "permanent": true
    },
    {
      "source": "/ig",
      "destination": "/abschalten?via=ig&utm_source=instagram&utm_medium=bio&utm_campaign=abschalten",
      "permanent": false
    },
    {
      "source": "/yt",
      "destination": "/abschalten?via=yt&utm_source=youtube&utm_medium=description&utm_campaign=abschalten",
      "permanent": false
    },
    {
      "source": "/start",
      "destination": "/abschalten?utm_source=direkt&utm_medium=kurzlink&utm_campaign=abschalten",
      "permanent": false
    },
    {
      "source": "/nacht",
      "missing": [{ "type": "query", "key": "via" }],
      "destination": "/nacht?via=nacht&utm_source=direkt&utm_medium=kurzlink&utm_campaign=nacht",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(sales-de|sales-en|sales-es|trigger-test|sales-trigger-de|sales-trigger-deepdive-de|muster-analyse|session)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
